{
    "name": "ms-pac-man-2010-js",
    "version": "1.0.0",
    "private": true,
    "license": "GPL-3.0-or-later",
    "type": "module",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "scripts": {
        "stamp": "node scripts/stamp.mjs",
        "clean": "node scripts/clean-dist.mjs",
        "generate:icons": "node scripts/generate-icons.mjs",
        "dev": "npm run dev:pwa",
        "dev:pwa": "vite --config pwa/vite.config.ts --host 127.0.0.1",
        "build:pwa": "npm run build:pwa:release",
        "build:pwa:unsigned": "node scripts/build-pwa-unsigned.mjs",
        "build:pwa:release": "node scripts/build-release.mjs --target=pwa --key-source=active",
        "_build:pwa:unsigned": "npm run generate:icons && npm run generate:resource-versions && tsc --project pwa/tsconfig.json && vite build --config pwa/vite.config.ts && npm run verify:pwa-build",
        "_build:pwa:release": "npm run generate:icons && npm run generate:resource-versions && tsc --project pwa/tsconfig.json && vite build --mode release --config pwa/vite.config.ts && npm run verify:pwa-build",
        "build:about": "npm run _build:about",
        "_build:about": "npm run generate:icons && node scripts/build-about.mjs",
        "build:desktop": "npm run build:desktop:unsigned",
        "build:desktop:unsigned": "npm run generate:icons && node scripts/build-desktop.mjs",
        "build:desktop:release": "node scripts/build-release.mjs --target=desktop --key-source=active",
        "_build:desktop:release": "npm run generate:icons && node scripts/build-desktop.mjs --release",
        "_assemble": "node scripts/assemble.mjs",
        "build:web": "npm run build:web:release",
        "build:web:unsigned": "node scripts/build-web-unsigned.mjs",
        "build:web:release": "node scripts/build-release.mjs --target=web --key-source=active",
        "build": "node scripts/build-release.mjs --target=full --key-source=active",
        "release": "npm run verify:dependencies && npm run build",
        "qualify": "node scripts/assert-clean-git.mjs && npm run format:check && npm run lint && npm test && npm run release && npm run verify:release && npm run verify:browser && npm run verify:offline && node scripts/assert-clean-git.mjs",
        "qualify:browsers": "npm run verify:production-browser",
        "release:provision": "node scripts/release-provision.mjs",
        "release:rotate-hmac": "node scripts/release-rotate-hmac.mjs",
        "release:finalize-hmac": "node scripts/release-finalize-hmac.mjs",
        "smoke:production-api": "node scripts/smoke-production-api.mjs",
        "hmac:init": "node scripts/hmac-cli.mjs init",
        "hmac:import": "node scripts/hmac-cli.mjs import",
        "hmac:check": "node scripts/hmac-cli.mjs check",
        "hmac:show": "node scripts/hmac-cli.mjs show",
        "hmac:rotate:prepare": "node scripts/hmac-cli.mjs rotate:prepare",
        "hmac:rotate:check": "node scripts/hmac-cli.mjs rotate:check",
        "hmac:rotate:show-next": "node scripts/hmac-cli.mjs rotate:show-next",
        "hmac:rotate:abort": "node scripts/hmac-cli.mjs rotate:abort",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "verify:dependencies": "npm audit --audit-level=high",
        "test": "node --test scripts/test-audio-unlock.mjs && node --test scripts/test-production-hardening.mjs && node --test scripts/test-pwa-manifest-identity.mjs && npm run test:session-ownership && npm run typecheck:native && npm run check:java-parity-metadata && npm run check:state-fields && npm run test:pwa-parity && npm run test:pwa-mode-reset && npm run test:pwa-state && npm run test:pwa-upload-restore && npm run test:pwa-tech-debt && npm run test:pwa-machinery-hardening && npm run check:resource-versions && npm run test:pwa-high-score && npm run test:pwa-build-config && npm run test:pwa-release-scripts && npm run test:pwa-unsigned-build && npm run test:about-page && npm run test:release-output-plan && npm run test:release-io && npm run test:release-lock && npm run test:release-dist-promotion && npm run test:hmac-config && npm run test:preview-release && npm run test:release-safety && npm run test:release-finalizer && npm run test:production-api-smoke && npm run test:desktop-controller-refresh && npm run test:desktop-high-score",
        "test:pwa-state": "node scripts/test-pwa-state.mjs",
        "test:pwa-upload-restore": "node scripts/test-pwa-upload-restore.mjs",
        "test:pwa-high-score": "node scripts/test-pwa-high-score.mjs",
        "test:pwa-build-config": "node scripts/test-pwa-build-config.mjs",
        "test:pwa-release-scripts": "node scripts/test-pwa-release-scripts.mjs",
        "test:pwa-unsigned-build": "node scripts/test-pwa-unsigned-build.mjs",
        "test:about-page": "node scripts/test-about-page.mjs && node --test scripts/test-about-html.mjs",
        "test:release-output-plan": "node scripts/test-release-output-plan.mjs",
        "test:release-io": "node scripts/test-release-io.mjs",
        "test:release-lock": "node scripts/test-release-lock.mjs",
        "test:release-dist-promotion": "node scripts/test-release-dist-promotion.mjs",
        "test:hmac-config": "node scripts/test-hmac-config.mjs",
        "test:preview-release": "node scripts/test-preview-release.mjs",
        "test:release-safety": "node scripts/test-release-safety.mjs",
        "test:release-finalizer": "node scripts/test-release-finalizer.mjs",
        "test:production-api-smoke": "node scripts/test-production-api-smoke.mjs",
        "test:desktop-controller-refresh": "node scripts/test-desktop-controller-refresh.mjs",
        "test:desktop-high-score": "node scripts/test-desktop-high-score.mjs",
        "verify:pwa-build": "node scripts/verify-pwa-build.mjs",
        "verify:release": "node scripts/verify-release.mjs --key-source=active",
        "preview": "npm run preview:pwa",
        "preview:pwa": "vite preview --config pwa/vite.config.ts --host 127.0.0.1",
        "preview:dist": "vite preview --host 127.0.0.1 --outDir dist",
        "preview:release": "node scripts/preview-release.mjs",
        "release:desktop": "node scripts/release-desktop.mjs",
        "run:desktop": "node scripts/run-desktop.mjs",
        "generate:resource-versions": "node scripts/generate-resource-versions.mjs",
        "check:resource-versions": "node scripts/generate-resource-versions.mjs --check",
        "test:pwa-tech-debt": "node scripts/test-pwa-tech-debt.mjs",
        "test:pwa-machinery-hardening": "node scripts/test-pwa-machinery-hardening.mjs",
        "verify:browser": "node scripts/run-browser-verification.mjs",
        "typecheck:native": "tsc --project pwa/tsconfig.native.json",
        "generate:java-parity-metadata": "node scripts/generate-java-parity-metadata.mjs",
        "check:java-parity-metadata": "node scripts/generate-java-parity-metadata.mjs --check",
        "generate:state-fields": "node scripts/generate-state-field-registry.mjs",
        "check:state-fields": "node scripts/generate-state-field-registry.mjs --check",
        "test:pwa-parity": "node scripts/test-pwa-parity.mjs",
        "test:pwa-mode-reset": "node scripts/test-mode-reset-contract.mjs",
        "verify:offline": "node scripts/run-offline-verification.mjs",
        "test:session-ownership": "node --test scripts/test-session-ownership.mjs",
        "verify:production-browser": "node scripts/run-production-browser-qualification.mjs",
        "release:archive": "node scripts/archive-release.mjs"
    },
    "dependencies": {
        "slick2d-ts": "https://codeload.github.com/meatfighter/slick2d-ts/tar.gz/f973bcb2155a14b8f7c90fc9b25ea5cedf326a0a"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.8.0",
        "globals": "^17.9.0",
        "prettier": "^3.9.6",
        "sharp": "0.35.3",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.0.0",
        "playwright": "1.63.0"
    }
}
