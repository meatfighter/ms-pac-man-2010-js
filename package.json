{
    "name": "ms-pac-man-2010-js",
    "version": "1.0.0",
    "private": true,
    "license": "GPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "stamp": "node scripts/stamp.mjs",
        "clean": "node scripts/clean-dist.mjs",
        "generate:icons": "node scripts/generate-icons.mjs",
        "dev": "npm run dev:pwa",
        "dev:pwa": "vite --config pwa/vite.config.ts --host 127.0.0.1",
        "build:pwa": "npm run generate:icons && tsc --project pwa/tsconfig.json && vite build --config pwa/vite.config.ts",
        "build:about": "npm run generate:icons && node scripts/build-about.mjs",
        "build:desktop": "npm run generate:icons && node scripts/build-desktop.mjs",
        "assemble": "node scripts/assemble.mjs",
        "build:web": "npm run stamp && npm run clean && npm run build:pwa && npm run build:about",
        "build": "npm run stamp && npm run clean && npm run build:pwa && npm run build:about && npm run build:desktop && npm run assemble",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "preview": "npm run preview:pwa",
        "preview:pwa": "vite preview --config pwa/vite.config.ts --host 127.0.0.1",
        "preview:dist": "vite preview --host 127.0.0.1 --outDir dist",
        "release:desktop": "npm run build:desktop && node scripts/copy-desktop-release.mjs",
        "run:desktop": "node scripts/run-desktop.mjs"
    },
    "dependencies": {
        "slick2d-ts": "git+https://github.com/meatfighter/slick2d-ts.git#semver:^1.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.8.0",
        "globals": "^17.9.0",
        "prettier": "^3.9.6",
        "sharp": "0.35.3",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.0.0"
    }
}
