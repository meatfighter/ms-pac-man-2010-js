<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.meatfighter</groupId>
    <artifactId>ms-pac-man-2010-desktop</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>Ms. Pac-Man 2010 Desktop</name>
    <description>Legacy Java desktop build for Ms. Pac-Man 2010.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
        <main.class>mspacman.Main</main.class>
        <runtime.classpath>lib/slick.jar lib/lwjgl.jar lib/lwjgl_util.jar lib/jinput.jar lib/jogg-0.0.7.jar lib/jorbis-0.0.17.jar lib/gson-2.11.0.jar</runtime.classpath>
    </properties>

    <dependencies>
        <dependency>
            <groupId>legacy.slick2d</groupId>
            <artifactId>slick</artifactId>
            <version>local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/slick.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>legacy.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <version>2.8.5-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/lwjgl.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>legacy.lwjgl</groupId>
            <artifactId>lwjgl-util</artifactId>
            <version>2.8.5-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/lwjgl_util.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>legacy.jinput</groupId>
            <artifactId>jinput</artifactId>
            <version>local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/jinput.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>legacy.jcraft</groupId>
            <artifactId>jogg</artifactId>
            <version>0.0.7-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/jogg-0.0.7.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>legacy.jcraft</groupId>
            <artifactId>jorbis</artifactId>
            <version>0.0.17-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/jorbis-0.0.17.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/gson-2.11.0.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src</sourceDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}/src</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <compilerArgs>
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Class-Path>${runtime.classpath}</Class-Path>
                        </manifestEntries>
                    </archive>
                    <finalName>${project.artifactId}</finalName>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-lib</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/lib</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-runtime-natives</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/natives</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/natives</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>${project.basedir}/assembly.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>desktop-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
